          }
        }
      }
    },
    "Your Discord username, description and a private-diagnostics link are visible in the forum. Only people with access to the private channel can open the diagnostics." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre de usuario de Discord, la descripción y un enlace al diagnóstico privado son visibles en el foro. Solo quienes tienen acceso al canal privado pueden abrir el diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nom d’utilisateur Discord, votre description et un lien vers les diagnostics privés sont visibles sur le forum. Seules les personnes ayant accès au canal privé peuvent ouvrir les diagnostics."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord 사용자 이름, 설명, 비공개 진단 링크는 포럼에 표시됩니다. 비공개 채널에 접근할 수 있는 사람만 진단 정보를 열 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Discord 用户名、描述和私密诊断链接在论坛中可见。只有能访问私密频道的人才能打开诊断信息。"
          }
        }
      }
    },
