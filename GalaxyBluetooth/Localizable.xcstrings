          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez ce formulaire pour les problèmes liés à l’app StarPilot, au Bluetooth ou au Wi-Fi. Pour les problèmes de véhicule ou de comportement de conduite, publiez dans le canal Discord ci-dessous."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StarPilot 앱, 블루투스, Wi-Fi 문제에는 이 양식을 사용하세요. 차량 문제나 주행 동작은 아래 Discord 채널에 올려 주세요."
          }
        },
        "zh-Hans" : {
