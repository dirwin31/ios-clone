        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "comma를 켜고 가까이 두세요. comma와 같은 Wi-Fi나 핫스팟에 연결한 뒤 블루투스 설정을 시작하세요."
          }
        },
        "zh-Hans" : {
