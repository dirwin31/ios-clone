    "Your comma requests a traffic-aware route from Google. If Google can’t supply it, the comma tries Mapbox." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu comma solicita a Google una ruta que tiene en cuenta el tráfico. Si Google no puede dársela, comma prueba con Mapbox."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre comma demande à Google un itinéraire tenant compte du trafic. Si Google ne peut pas le fournir, comma essaie Mapbox."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "comma가 Google에 교통 상황을 반영한 경로를 요청합니다. Google이 제공하지 못하면 comma는 Mapbox를 시도합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "comma 会向 Google 请求考虑路况的路线。如果 Google 无法提供，comma 会尝试 Mapbox。"
          }
        }
      }
    },
    "Your Discord username and report are visible to people with access to the forum." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nombre de usuario de Discord y tu informe son visibles para quienes tienen acceso al foro."
